/**pages/index/index.wxss**/

.container {
  padding: 40rpx 30rpx;
  padding-bottom: 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
  align-items: center;
}

/* ===== 进度圆环（双半圆方案） ===== */
.progress-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  margin-bottom: 20rpx;
}

.progress-ring {
  position: relative;
  width: 260rpx;
  height: 260rpx;
}

.circle-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 12rpx solid #E8E5F5;
  box-sizing: border-box;
  top: 0;
  left: 0;
}

.circle-half {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  overflow: hidden;
}

.circle-right-wrap {
  left: 50%;
}

.circle-left-wrap {
  left: 0;
}

.circle-half-inner {
  position: absolute;
  width: 200%;
  height: 100%;
  border-radius: 50%;
  border: 12rpx solid #6C5CE7;
  box-sizing: border-box;
  top: 0;
  transform-origin: center center;
  transition: transform 0.5s ease;
}

.circle-right-clip {
  left: -100%;
  clip: rect(0, auto, auto, 50%);
}

.circle-left-clip {
  left: 0;
  clip: rect(0, 50%, auto, auto);
}

/* 进度 0% 时隐藏 */
.progress-ring[data-percent="0"] .circle-half-inner {
  display: none;
}

.ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 2;
}

.ring-number {
  font-size: 64rpx;
  font-weight: 700;
  color: #6C5CE7;
}

.ring-label {
  font-size: 24rpx;
  color: #A09DB5;
  margin-top: 4rpx;
}

.target-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #6B6880;
}

/* ===== 连续打卡 ===== */
.streak-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 166, 46, 0.15), rgba(255, 166, 46, 0.05));
  border: 1rpx solid rgba(255, 166, 46, 0.3);
  border-radius: 40rpx;
  padding: 10rpx 30rpx;
  margin-bottom: 40rpx;
}

.streak-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.streak-text {
  font-size: 26rpx;
  color: #FFA62E;
  font-weight: 500;
}

/* ===== 开始背诵按钮 ===== */
.start-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.start-btn {
  width: 400rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(108, 92, 231, 0.4);
  transition: all 0.2s ease;
  border: none;
}

.start-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.3);
}

.start-btn-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.start-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #A09DB5;
}

/* ===== 底部统计卡片 ===== */
.stats-section {
  width: 100%;
  display: flex;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.stat-card-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.stat-card-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #2D2B3D;
  margin-bottom: 6rpx;
}

.stat-card-label {
  font-size: 24rpx;
  color: #A09DB5;
}
