<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部进度区 -->
  <view class="progress-hero">
    <!-- 双半圆进度环 -->
    <view class="progress-ring">
      <view class="circle-bg"></view>
      <!-- 右半圆 -->
      <view class="circle-half circle-right-wrap">
        <view class="circle-half-inner circle-right-clip" style="transform: rotate({{rightRotate}}deg);"></view>
      </view>
      <!-- 左半圆 -->
      <view class="circle-half circle-left-wrap">
        <view class="circle-half-inner circle-left-clip" style="transform: rotate({{leftRotate}}deg);"></view>
      </view>
      <!-- 中心文字 -->
      <view class="ring-center">
        <view class="ring-number">{{dailyCompleted}}</view>
        <view class="ring-label">已完成</view>
      </view>
    </view>
    <view class="target-text">今日目标 {{dailyTarget}} 词</view>
  </view>

  <!-- 连续打卡 -->
  <view class="streak-badge" wx:if="{{streakDays > 0}}">
    <text class="streak-icon">🔥</text>
    <text class="streak-text">连续打卡 {{streakDays}} 天</text>
  </view>

  <!-- 开始背诵按钮 -->
  <view class="start-section">
    <button class="start-btn" bindtap="onStartStudy">
      <view class="start-btn-text">开始背诵</view>
    </button>
    <view class="start-hint" wx:if="{{progressPercent >= 100}}">今日已完成，继续加油！</view>
  </view>

  <!-- 底部统计区 -->
  <view class="stats-section">
    <view class="stat-card">
      <view class="stat-card-icon">📖</view>
      <view class="stat-card-value">{{todayNewWords}}</view>
      <view class="stat-card-label">今日新词</view>
    </view>
    <view class="stat-card">
      <view class="stat-card-icon">🔄</view>
      <view class="stat-card-value">{{todayReviewWords}}</view>
      <view class="stat-card-label">今日复习</view>
    </view>
  </view>
</view>
