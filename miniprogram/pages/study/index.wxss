/**pages/study/index.wxss**/

.container {
  padding: 30rpx;
  padding-bottom: 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 进度条 */
.progress-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #E8E5F5;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7, #A29BFE);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  text-align: center;
  font-size: 26rpx;
  color: #6B6880;
}

/* 单词卡片 */
.word-card {
  position: relative;
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.1);
  margin-bottom: 50rpx;
}

.word-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #2D2B3D;
  letter-spacing: 2rpx;
}

.phonetic-text {
  font-size: 28rpx;
  color: #A09DB5;
  margin-top: 12rpx;
}

/* 听音区域 */
.listening-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.speaker-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  transition: transform 0.2s ease;
}

.speaker-icon.pulse {
  animation: speakerPulse 0.8s ease-in-out infinite;
}

@keyframes speakerPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.15); opacity: 0.7; }
}

.listening-hint {
  font-size: 28rpx;
  color: #A09DB5;
  margin-bottom: 30rpx;
}

.skip-btn {
  padding: 14rpx 40rpx;
  background: rgba(108, 92, 231, 0.08);
  color: #6C5CE7;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: 2rpx solid rgba(108, 92, 231, 0.2);
}

.skip-btn:active {
  background: rgba(108, 92, 231, 0.15);
}

/* 单词展示后的重播按钮 */
.replay-mini-btn {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: rgba(108, 92, 231, 0.06);
  border-radius: 50%;
}

.replay-mini-btn:active {
  background: rgba(108, 92, 231, 0.15);
  transform: scale(0.9);
}

/* 淡入动画 */
.fade-in {
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 选项网格 */
.options-grid {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.option-btn {
  background: #FFFFFF;
  border: 2rpx solid #E8E5F5;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 12rpx rgba(108, 92, 231, 0.04);
}

.option-btn:active {
  transform: scale(0.97);
}

.option-meaning {
  font-size: 26rpx;
  color: #2D2B3D;
  line-height: 1.5;
  word-break: break-all;
}

.option-icon {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.option-correct {
  background: #E8F8F0;
  border-color: #00C48C;
  box-shadow: 0 4rpx 16rpx rgba(0, 196, 140, 0.15);
}

.option-correct .option-icon {
  background: #00C48C;
}

.option-wrong {
  background: #FFF0F0;
  border-color: #FF6B6B;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.15);
}

.option-wrong .option-icon {
  background: #FF6B6B;
}

/* 完成弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 43, 61, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  width: 580rpx;
  text-align: center;
  animation: slideUp 0.4s ease;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2D2B3D;
  margin-bottom: 40rpx;
}

.modal-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #6C5CE7;
  margin-bottom: 8rpx;
}

.stat-value.green {
  color: #00C48C;
}

.stat-value.red {
  color: #FF6B6B;
}

.stat-label {
  font-size: 24rpx;
  color: #A09DB5;
}

.modal-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.3);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 0 10rpx;
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #FFFFFF;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.25);
  transition: all 0.2s ease;
}

.nav-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.nav-btn-disabled {
  background: #E8E5F5;
  color: #B5B2C8;
  box-shadow: none;
}

.nav-btn-disabled:active {
  transform: none;
  opacity: 1;
}

.nav-btn-complete {
  background: linear-gradient(135deg, #00C48C, #34D399);
  box-shadow: 0 4rpx 16rpx rgba(0, 196, 140, 0.25);
}
